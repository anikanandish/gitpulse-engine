# GitPulse Engine Environment Variables
# Copy this file to .env to configure local settings

# GitHub Webhook HMAC Secret (optional in development; recommended for production)
WEBHOOK_SECRET=your_github_webhook_secret_here

# SQLite Database File Path (defaults to gitpulse.db)
GITPULSE_DB_FILE=gitpulse.db

# Optional Multi-Channel Alert Dispatcher Webhook URLs
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Maximum Allowed Ingestion Payload Size in Bytes (default 2097152 = 2MB)
MAX_PAYLOAD_SIZE=2097152

# Notification Dispatch Retry Settings
MAX_DISPATCH_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5


